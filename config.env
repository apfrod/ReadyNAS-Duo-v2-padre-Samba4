# ============================================================================
# config.env — single source of truth for the ReadyNAS-SPARC Samba 4 build.
# Sourced by every phase script and by build.sh. Override any value from the
# environment, e.g.  SAMBA_VERSION=4.9.18 ./build.sh samba
# ============================================================================

# ---- Target CPU / ABI ------------------------------------------------------
# Infrant IT3107 ("Padre"): 32-bit BIG-ENDIAN SPARC v8 variant that must be
# built with v7 codegen (it lacks some v8 hardware ops). Do NOT change to v8.
: "${TARGET:=sparc-unknown-linux-gnu}"
: "${TARGET_CPU:=v7}"
: "${TARGET_CFLAGS:=-mcpu=v7 -O2 -pipe}"

# Install prefix ON THE DEVICE. Everything is self-contained under here.
: "${PREFIX:=/opt/samba}"

# ---- Toolchain component versions -----------------------------------------
# CTNG_VERSION and KERNEL_HEADERS are used by 01-build-toolchain.sh directly.
# The gcc/binutils/glibc versions, however, are chosen inside
# toolchain/crosstool-ng.defconfig via crosstool-NG *choice* symbols
# (CT_GCC_V_7, CT_BINUTILS_V_2_32, CT_GLIBC_V_2_19). The three vars below are
# INFORMATIONAL — they document the intent; to actually change a version, edit
# the choice symbol in the defconfig (and keep this in sync).
: "${CTNG_VERSION:=1.25.0}"     # crosstool-NG (ships glibc 2.19 + gcc 7.5)
: "${GCC_VERSION:=7.5.0}"       # <- set in defconfig as CT_GCC_V_7
: "${BINUTILS_VERSION:=2.32}"   # <- set in defconfig as CT_BINUTILS_V_2_32
# glibc 2.19 is the NEWEST glibc that still RUNS on a 2.6.17 kernel: glibc 2.20
# raised the minimum kernel to 2.6.32 and 2.26 to 3.2. A newer glibc would
# build fine but abort at startup on the device with "FATAL: kernel too old".
: "${GLIBC_VERSION:=2.19}"      # <- set in defconfig as CT_GLIBC_V_2_19
# Kernel headers version. The device runs 2.6.17.14, but kernel.org no longer
# ships the .14 point-release tarball, and the userspace/syscall ABI is
# identical across a 2.6.17.x stable series (point releases are bug-fix only).
# So we use the base 2.6.17 headers — correct and guaranteed available.
: "${KERNEL_HEADERS:=2.6.17}"

# ---- Samba ----------------------------------------------------------------
# 4.13.x = solid SMB3 + manageable deps for a --without-ad-dc file server.
# Fall back to 4.9.x if a newer release won't build against the 2.6.17 ABI.
# 4.0 is the absolute floor for any SMB3 support.
: "${SAMBA_VERSION:=4.13.17}"

# ---- Target dependency versions -------------------------------------------
: "${ZLIB_VERSION:=1.2.13}"
: "${POPT_VERSION:=1.19}"
: "${LIBGPG_ERROR_VERSION:=1.47}"
: "${LIBGCRYPT_VERSION:=1.10.2}"
: "${GMP_VERSION:=6.2.1}"
: "${NETTLE_VERSION:=3.6}"           # pairs with gnutls 3.6.x
: "${LIBTASN1_VERSION:=4.19.0}"
: "${LIBUNISTRING_VERSION:=1.1}"
: "${GNUTLS_VERSION:=3.6.16}"        # mandatory for SMB3 signing/encryption

# ---- Paths (inside the Docker container; repo is mounted at /work) ---------
: "${WORK:=/work}"
: "${DL:=$WORK/downloads}"
: "${SRC:=$WORK/src}"
: "${BUILD:=$WORK/build}"
: "${XTOOLS:=$WORK/x-tools}"
: "${TOOLCHAIN_DIR:=$XTOOLS/$TARGET}"
: "${SYSROOT:=$TOOLCHAIN_DIR/$TARGET/sysroot}"
: "${STAGE:=$WORK/stage}"            # DESTDIR root; final tree at $STAGE$PREFIX
: "${DIST:=$WORK/dist}"              # output tarballs land here
: "${STAMP:=$WORK/.stamp}"           # per-phase completion markers (resumable)

# Staging prefix for cross-built deps: they install into the sysroot under
# $PREFIX so pkg-config/headers resolve during the Samba configure step.
: "${DEP_PREFIX:=$SYSROOT$PREFIX}"

# ---- Device install defaults (used by install/install-on-device.sh) -------
: "${NAS_HOST:=readynas}"        # ssh host/IP of the ReadyNAS
: "${NAS_USER:=root}"
: "${NAS_DATA_DIR:=/c/opt}"      # writable data-volume path; $PREFIX symlinks here
