#======================= Global Settings =====================================
# Lean SMB2/SMB3 file server for the Infrant SPARC ReadyNAS.
# Tuned small: this is a ~280 MHz CPU with limited RAM. Keep it minimal.
[global]
   workgroup = WORKGROUP
   server string = ReadyNAS Samba4
   netbios name = READYNAS

   # --- Charsets: MUST stay on Samba's built-in converters ------------------
   # This smbd is fully static, and glibc's iconv dlopen()s its charset modules
   # (/usr/lib/gconv/*.so) at runtime. In a static binary that either fails or,
   # with the device's stock glibc-2.3.2 modules, loads an ABI-incompatible .so
   # and CRASHES the connection (SIGILL) — e.g. when reading a file's stored DOS
   # attributes. Samba has its OWN built-in converters for UTF-8, UTF-16LE,
   # UCS-2LE, ASCII and ISO-8859-1, so pin every charset to one of those and
   # smbd never calls glibc iconv. In particular `dos charset` must be a
   # single-byte built-in: ISO-8859-1 (NOT CP850/CP437 — those need a module).
   unix charset = UTF-8
   dos charset = ISO-8859-1

   # --- Protocol: force modern SMB, refuse the deprecated SMB1/CIFS ---------
   server min protocol = SMB2
   server max protocol = SMB3
   client min protocol = SMB2
   # Signing "auto" = allow but don't force (forced signing is CPU-heavy here).
   server signing = auto
   # SMB3 encryption works but is SLOW on this CPU — leave off unless needed:
   # smb encrypt = desired

   # --- Keep it light --------------------------------------------------------
   load printers = no
   printing = bsd
   printcap name = /dev/null
   disable spoolss = yes
   log level = 1
   max log size = 200
   log file = /opt/samba/var/log.%m
   deadtime = 15
   socket options = TCP_NODELAY

   # --- Simplest auth to start: standalone server, local users --------------
   # Create users on the device with: /opt/samba/sbin/smbpasswd -a <user>
   security = user
   passdb backend = tdbsam
   map to guest = never

#======================= Shares ==============================================
# Point 'path' at a directory on your data volume. Adjust owner/permissions.
[media]
   comment = ReadyNAS data share
   path = /c/media
   browseable = yes
   read only = no
   valid users = @users
   create mask = 0664
   directory mask = 0775
