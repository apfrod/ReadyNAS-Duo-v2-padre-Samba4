#!/bin/sh
# Self-contained launcher — runs the real binary through OUR bundled loader
# and libraries so Samba never touches the device's ancient system glibc.
# Generated by 04-make-package.sh (placeholders substituted at build time).
PREFIX="@PREFIX@"
# Samba installs its internal libs under lib/private (smbd NEEDs libsmbd-base
# -samba4.so etc. from there), so both dirs must be on the loader search path.
exec "$PREFIX/lib/ld-linux.so.2" --library-path "$PREFIX/lib:$PREFIX/lib/private" \
     "$PREFIX/@BINREL@" "$@"
